# @phosphor-icons/react types extend ComponentPropsWithoutRef<"svg">, which needs
# @types/react resolvable from inside the package. pnpm's isolated store hides it,
# which silently strips className off IconProps. Hoisting the type packages fixes it.
public-hoist-pattern[]=@types/react
public-hoist-pattern[]=@types/react-dom

# This machine has a GLOBAL pnpm setting:
#   virtual-store-dir=C:\VOICELY\friday\frontend\node_modules\.pnpm
# which links every project's dependencies into an unrelated project's store and
# breaks Turbopack resolution ("Could not find the Next.js package"). Pin the
# virtual store back into this project. Scoped here so the global config, and
# whatever depends on it, is left alone.
virtual-store-dir=node_modules/.pnpm
